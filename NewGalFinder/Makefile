#--------------------------------------------------
#--- Makefile for NewGalFinder
#--- Generated by ../configure
#--------------------------------------------------

#--- Objects to build
OBJS		= gfind.o Memory2.o force_spline.mod3.o ost.o \
			src/finder_state.o src/geometry.o src/peaks.o src/basin_members.o src/shells.o \
			src/binding.o src/membership_fof.o src/catalogue.o src/find_galaxies.o \
			nrutil.o b2l.o spline.mod2.o \
			nnost.o  utils.o mkRtidal.o tsc_omp2.o gsmooth.o \
			Treewalk.near.o

PROGS =  gfind.exe

AR = ar  rcv
RANLIB = ranlib

#--------------------------------------------------
# Compiler settings (configured by ../configure)
#--------------------------------------------------
FFTW = /home/kjhan/local

FC = mpiifx
CC = mpiicx

INCLUDES = -I$(FFTW)/include

DFLAGS = -DNMEG=90000L

# Add -DNBODY when reading a dark-matter-only opFoF member file. Leave this
# empty for hydro catalogues, whose particle records carry the extra fields.
DMO_FLAGS ?=

# The particle records consumed from opFoF must use the same RAMSES layout as
# NewDD/opFoF. Keep NCHEM/NDUST identical for hydro inputs and set DMO_FLAGS
# for the compact DMO layout.
OPT = -O3  -qopenmp -DINDEX -DVarPM   -DXYZDBL -DNENER=0 -DNPRE=8 -DREAD_SINK -DNCHEM=9 -DNDUST=4 -DADV $(DMO_FLAGS)

FFLAGS = $(FDFLAGS) $(OPT)  -mcmodel=medium
CFLAGS = $(DFLAGS)  $(OPT) $(INCLUDES) -I. -Isrc -DDEBUG=1 -DLOG=1

LIBS = -L$(FFTW)/lib -lfftw3f_omp -lfftw3f -lm

#--- Suffix-based compilation rules
.SUFFIXES: .exe .o .c .f .F

#rules to build binary from source
.c.o :
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

.f.o :
	$(FC) $(FFLAGS) $(INCLUDES) -c $<

.for.o :
	$(FC) $(FFLAGS) $(INCLUDES) -c $<

.F.o :
	$(FC) $(FFLAGS) $(INCLUDES) -c $<

.c.exe :
	$(CC) $(OPT) $(INCLUDES) -o $*.exe $(OBJS) $(MPI_LINKS) $(LIBS)

.f.exe :
	$(FC) $(OPT) $(INCLUDES) -o $*.exe $(OBJS) $(MPI_LINKS) $(LIBS)

.for.exe :
	$(FC) $(OPT) $(INCLUDES) -o $*.exe $(OBJS) $(MPI_LINKS) $(LIBS)

.F.exe :
	$(FC) $(OPT) $(INCLUDES) -o $*.exe $(OBJS) $(MPI_LINKS) $(LIBS)

#--- Targets
all:
	\rm -f $(PROGS)
	$(MAKE) $(PROGS)
new: clean
	$(MAKE) all
clean:
	rm -f $(OBJS)
	rm -f $(PROGS)
$(PROGS): $(OBJS)
